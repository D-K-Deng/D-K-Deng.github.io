---
import AboutExperience from "@components/AboutExperience.svelte";

import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
  title={i18n(I18nKey.about)}
  description="Zhaowen Deng — building thoughtful systems at the intersection of AI, HCI, and intelligent agents."
  immersive
>
  <script is:inline slot="head">
    document.documentElement.classList.add("about-page-active");
  </script>
  <AboutExperience client:load />
</MainGridLayout>
