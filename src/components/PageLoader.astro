<div
  id="page-loader"
  class="page-loader"
  role="status"
  aria-live="polite"
  aria-atomic="true"
  aria-hidden="true"
>
  <div class="page-loader__content">
    <div class="page-loader__scene" aria-hidden="true">
      <div class="page-loader__mark">
        <span class="page-loader__orbit page-loader__orbit--outer"></span>
        <span class="page-loader__orbit page-loader__orbit--inner"></span>
        <i></i>
      </div>
      <img
        class="page-loader__character"
        src="/image/about-loader-character.webp"
        alt=""
        width="420"
        height="455"
        loading="eager"
        decoding="async"
        draggable="false"
      />
    </div>
    <div class="page-loader__bubble">
      <strong id="page-loader-message">
        Getting everything ready
      </strong>
      <span class="page-loader__typing" aria-hidden="true">
        <i></i><i></i><i></i>
      </span>
    </div>
  </div>
</div>

<style is:global>
  :root {
    --page-loader-bg: rgba(247, 249, 253, 0.94);
    --page-loader-panel: rgba(255, 255, 255, 0.68);
    --page-loader-text: #172033;
    --page-loader-muted: rgba(32, 43, 64, 0.52);
    --page-loader-line: rgba(76, 94, 132, 0.2);
    --page-loader-accent-a: #6478df;
    --page-loader-accent-b: #a479df;
    --page-loader-shadow: rgba(53, 67, 103, 0.16);
    --page-loader-bubble: rgba(255, 255, 255, 0.86);
    --page-loader-bubble-line: rgba(76, 94, 132, 0.18);
  }

  html.dark {
    --page-loader-bg: rgba(5, 7, 12, 0.95);
    --page-loader-panel: rgba(15, 19, 31, 0.7);
    --page-loader-text: #f5f7ff;
    --page-loader-muted: rgba(225, 232, 250, 0.54);
    --page-loader-line: rgba(190, 204, 255, 0.17);
    --page-loader-accent-a: #89a3ff;
    --page-loader-accent-b: #c395ff;
    --page-loader-shadow: rgba(0, 0, 0, 0.44);
    --page-loader-bubble: rgba(17, 21, 34, 0.88);
    --page-loader-bubble-line: rgba(190, 204, 255, 0.16);
  }

  html.about-page-active:not(.dark) {
    --page-loader-bg: rgba(242, 245, 251, 0.95);
    --page-loader-panel: rgba(255, 255, 255, 0.7);
    --page-loader-accent-a: #5b72db;
    --page-loader-accent-b: #9a6fd0;
  }

  #page-loader {
    position: fixed;
    z-index: 1000;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    color: var(--page-loader-text);
    background:
      radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--page-loader-accent-a) 12%, transparent), transparent 31rem),
      var(--page-loader-bg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 280ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 280ms step-end;
    backdrop-filter: blur(22px) saturate(1.18);
    -webkit-backdrop-filter: blur(22px) saturate(1.18);
  }

  html.site-loader-visible #page-loader {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 240ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0ms step-start;
  }

  html.site-booting #page-loader {
    visibility: visible;
    pointer-events: auto;
    animation: page-loader-boot-in 240ms 180ms both cubic-bezier(0.22, 1, 0.36, 1);
  }

  .page-loader__content {
    display: grid;
    justify-items: center;
    gap: 0;
    box-sizing: border-box;
    width: min(21rem, calc(100vw - 2rem));
    padding: 1.2rem 1.25rem 1.35rem;
    border: 1px solid var(--page-loader-line);
    border-radius: 2rem;
    background: var(--page-loader-panel);
    box-shadow:
      0 1.5rem 4rem var(--page-loader-shadow),
      inset 0 1px color-mix(in srgb, var(--page-loader-text) 7%, transparent);
  }

  .page-loader__scene {
    position: relative;
    width: 16rem;
    height: 8.7rem;
    isolation: isolate;
  }

  .page-loader__scene::before {
    position: absolute;
    z-index: 0;
    top: 47%;
    left: 50%;
    width: 9.8rem;
    height: 9.8rem;
    border-radius: 50%;
    content: "";
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--page-loader-accent-b) 15%, transparent),
      transparent 68%
    );
    filter: blur(0.15rem);
    transform: translate(-50%, -50%);
  }

  .page-loader__scene::after {
    position: absolute;
    z-index: 2;
    bottom: 0.05rem;
    left: 50%;
    width: 8.4rem;
    height: 1.15rem;
    border-radius: 50%;
    content: "";
    background: radial-gradient(
      ellipse,
      color-mix(in srgb, var(--page-loader-accent-a) 24%, transparent),
      transparent 68%
    );
    filter: blur(0.22rem);
    transform: translateX(-50%);
  }

  .page-loader__mark {
    position: absolute;
    z-index: 1;
    top: 0.35rem;
    left: 50%;
    width: 7.8rem;
    height: 7.8rem;
    transform: translateX(-50%);
  }

  .page-loader__character {
    position: absolute;
    z-index: 3;
    right: -0.25rem;
    bottom: 0.5rem;
    display: block;
    width: 4rem;
    height: auto;
    filter:
      drop-shadow(0 0.65rem 0.8rem rgba(39, 31, 42, 0.18))
      drop-shadow(0 0 0.55rem color-mix(in srgb, var(--page-loader-accent-b) 20%, transparent));
    transform-origin: 50% 92%;
    animation: page-loader-character 2.4s ease-in-out infinite;
    pointer-events: none;
    user-select: none;
  }

  .page-loader__orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 68%;
    border: 1px solid var(--page-loader-line);
    border-radius: 50%;
    transform-origin: 50% 50%;
  }

  .page-loader__orbit::after {
    position: absolute;
    top: -0.18rem;
    left: 50%;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    content: "";
    background: var(--page-loader-accent-a);
    box-shadow: 0 0 1rem color-mix(in srgb, var(--page-loader-accent-a) 72%, transparent);
    transform: translateX(-50%);
  }

  .page-loader__orbit--outer {
    transform: translate(-50%, -50%) rotate(-24deg);
    animation: page-loader-orbit-outer 3.2s linear infinite;
  }

  .page-loader__orbit--inner {
    width: 88%;
    height: 58%;
    border-color: color-mix(in srgb, var(--page-loader-accent-b) 38%, transparent);
    transform: translate(-50%, -50%) rotate(38deg);
    animation: page-loader-orbit-inner 2.55s linear infinite;
  }

  .page-loader__orbit--inner::after {
    top: auto;
    right: -0.14rem;
    bottom: 0.28rem;
    left: auto;
    width: 0.34rem;
    height: 0.34rem;
    background: var(--page-loader-accent-b);
    box-shadow: 0 0 0.9rem color-mix(in srgb, var(--page-loader-accent-b) 70%, transparent);
    transform: none;
  }

  .page-loader__mark i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--page-loader-accent-a), var(--page-loader-accent-b));
    box-shadow: 0 0 1.4rem color-mix(in srgb, var(--page-loader-accent-a) 42%, transparent);
    transform: translate(-50%, -50%);
    animation: page-loader-pulse 1.4s ease-in-out infinite;
  }

  .page-loader__bubble {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    box-sizing: border-box;
    width: min(17.25rem, 100%);
    min-height: 3.15rem;
    margin-top: -0.45rem;
    padding: 0.78rem 1.05rem;
    border: 1px solid var(--page-loader-bubble-line);
    border-radius: 1.2rem;
    text-align: center;
    background: var(--page-loader-bubble);
    box-shadow:
      0 0.8rem 1.8rem color-mix(in srgb, var(--page-loader-shadow) 72%, transparent),
      inset 0 1px color-mix(in srgb, var(--page-loader-text) 6%, transparent);
    backdrop-filter: blur(16px) saturate(1.15);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
  }

  .page-loader__bubble::before {
    position: absolute;
    top: -0.38rem;
    left: auto;
    right: 2.05rem;
    width: 0.68rem;
    height: 0.68rem;
    border-top: 1px solid var(--page-loader-bubble-line);
    border-left: 1px solid var(--page-loader-bubble-line);
    content: "";
    background: var(--page-loader-bubble);
    transform: rotate(45deg);
  }

  .page-loader__bubble strong {
    color: var(--page-loader-text);
    font-size: 0.9rem;
    font-weight: 560;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .page-loader__typing {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.22rem;
  }

  .page-loader__typing i {
    display: block;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: var(--page-loader-accent-a);
    animation: page-loader-typing 1.15s ease-in-out infinite;
  }

  .page-loader__typing i:nth-child(2) {
    animation-delay: 120ms;
  }

  .page-loader__typing i:nth-child(3) {
    animation-delay: 240ms;
  }

  @keyframes page-loader-boot-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes page-loader-orbit-outer {
    from { transform: translate(-50%, -50%) rotate(-24deg); }
    to { transform: translate(-50%, -50%) rotate(336deg); }
  }

  @keyframes page-loader-orbit-inner {
    from { transform: translate(-50%, -50%) rotate(38deg); }
    to { transform: translate(-50%, -50%) rotate(-322deg); }
  }

  @keyframes page-loader-pulse {
    0%, 100% { transform: translate(-50%, -50%) scale(0.82); opacity: 0.72; }
    50% { transform: translate(-50%, -50%) scale(1.08); opacity: 1; }
  }

  @keyframes page-loader-character {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-1.2deg); }
    50% { transform: translate3d(0, -0.24rem, 0) rotate(1deg); }
  }

  @keyframes page-loader-typing {
    0%, 55%, 100% { opacity: 0.3; transform: translateY(0); }
    25% { opacity: 1; transform: translateY(-0.18rem); }
  }

  @media (max-width: 420px) {
    .page-loader__content {
      width: calc(100vw - 1.25rem);
      padding: 0.95rem 0.85rem 1.15rem;
    }

    .page-loader__scene {
      width: 13.75rem;
      height: 8rem;
    }

    .page-loader__mark {
      width: 7.1rem;
      height: 7.1rem;
    }

    .page-loader__character {
      right: -0.3rem;
      bottom: 0.45rem;
      width: 3.55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html.site-booting #page-loader,
    .page-loader__orbit--outer,
    .page-loader__orbit--inner,
    .page-loader__mark i,
    .page-loader__character,
    .page-loader__typing i {
      animation: none;
    }

    html.site-booting #page-loader {
      opacity: 1;
    }
  }
</style>
